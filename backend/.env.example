# Environment
ENVIRONMENT=development
MONEY_MOVEMENT_MODE=sandbox

# Database configuration
DB_DIALECT=postgresql
POSTGRES_SERVER=localhost
POSTGRES_USER=arezak
POSTGRES_PASSWORD=arezak_password
POSTGRES_DB=arezak_db

# Security
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7

# CORS
CORS_ORIGINS=http://localhost:3000

# Social Auth
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Object storage for profile photos (any S3-compatible service).
# Staging/production use Supabase Storage. Generate the keys under
# Supabase Dashboard -> Project Settings -> Storage -> S3 Access Keys.
# These are server-side only: never expose them through NEXT_PUBLIC_*.
STORAGE_BUCKET=avatars
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Required for any non-AWS endpoint. For Supabase:
#   https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
# Optional. Public object base URL; derived from the endpoint when omitted.
#   https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
STORAGE_PUBLIC_BASE_URL=

# Payment Providers
AKESEL_WEBHOOK_SECRET=

ARKESEL_WEBHOOK_SECRET=
ARKESEL_SMS_API_KEY=
